{
  "name": "opencode-loopper-frontend",
  "private": true,
  "version": "0.4.90",
  "type": "module",
  "scripts": {
    "postinstall": "node ../scripts/patch-xyflow-react.mjs apply",
    "patch:apply": "node ../scripts/patch-xyflow-react.mjs apply",
    "patch:check": "node ../scripts/patch-xyflow-react.mjs check",
    "patch:inspect": "node ../scripts/patch-xyflow-react.mjs inspect",
    "test:patches": "node --test ../scripts/tests/xyflow-react-patch.test.mjs",
    "dev": "vite",
    "prebuild": "npm run patch:check",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:foundation": "node ../scripts/generate-foundation-icons.mjs --check && vitest run src/foundation",
    "typecheck:foundation": "tsc -p tsconfig.w1.json",
    "build:foundation-preview": "vite build --config e2e/w1/vite.config.ts",
    "test:foundation-browser": "node e2e/w1/verify-foundation.mjs",
    "test:tooling": "node ../scripts/check-project.mjs && node --test ../scripts/tests/project-tooling.test.mjs ../scripts/tests/distribution-packaging.test.mjs ../scripts/tests/xyflow-react-patch.test.mjs",
    "test:e2e": "playwright test",
    "test:accounting": "node --test ../scripts/aicoding/guard.test.mjs ../scripts/tests/package-semantic-guard.test.mjs ../scripts/tests/knowledge-native-guard.test.mjs",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify/vue": "^5.0.0",
    "@lezer/highlight": "^1.2.3",
    "@vueuse/core": "^13.0.0",
    "@xyflow/react": "12.12.0",
    "antd": "6.6.5",
    "dompurify": "^3.4.13",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.6",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.0",
    "pinia": "^3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
